MAPRENDER_SVG_BASE_PATH=/home/freemap/X/freemap-outdoor-map/images
MAPRENDER_HILLSHADING_BASE_PATH=/fm/data2/hillshading
# Per-country hillshading priority. Each entry is `country` or `country:better1,better2,…`.
# A "better" country's hillshading mask overrides this country's. Order matters.
# Each country in the list must have its dataset at <HILLSHADING_BASE_PATH>/<country>/final.tif.
# If unset, no shading is rendered.
MAPRENDER_HILLSHADING_HIERARCHY=at:sk,si,cz;it:at,ch,si,fr;ch:at,fr;si;cz:sk,pl;pl:sk;sk;fr;fi;no:fi
# Country contour sources. Comma-separated country codes; the token `_` includes the
# global fallback. Country contours load from DB layer `contours_<lc>` (or `contours_fallback`).
# Every country here must also be a key in MAPRENDER_HILLSHADING_HIERARCHY.
# If unset, no contours are rendered.
MAPRENDER_CONTOUR_COUNTRIES=at,it,ch,si,cz,pl,sk,fr,no,_
# Per-country place type remapping, for countries tagging `place=*` more finely than the
# style expects. `<country>:<rule>[,<rule>…][;<country>:…]`, where the country is a lowercase
# ISO 3166-1 alpha-2 code or `*` for every country without rules of its own, and `<rule>` is
# `<from>[@<population>]=<to>`. The target is `z<zoom>[/<style>]` — from which zoom to label
# the place, in which style (xxl 1.20 CAPS, xl 0.80 CAPS, l 0.55 CAPS, m 0.50, s 0.45,
# xs 0.40, xxs 0.35; the source type's own style if omitted) — or `-` to not label the type
# at all. `@<population>` matches only places below that population (untagged counts as 0);
# several rules for one type form tiers — lowest matching population wins, a rule without
# `@` takes the rest. Only postponing is allowed. Requires the `countries` table
# (see sql/countries.sql). If unset, places look the same everywhere.
# MAPRENDER_PLACE_TYPE_OVERRIDES=hr:village@100=z13/s,hamlet=z16/xxs;pl:hamlet=z16/xxs
MAPRENDER_WORKER_COUNT=128
MAPRENDER_POOL_MAX_SIZE=128
MAPRENDER_DATABASE_URL=postgis://osm_user:osm_password@localhost/osm_db
MAPRENDER_HOST=127.0.0.1
MAPRENDER_PORT=4000
MAPRENDER_MAX_CONCURRENT_CONNECTIONS=4096
MAPRENDER_GLOBAL_TIMEOUT_SECS=100
MAPRENDER_COVERAGE_GEOJSON=/home/freemap/X/freemap-outdoor-map/limit-europe.geojson
MAPRENDER_ALLOWED_SCALES=1,2,3
MAPRENDER_EXPIRES_BASE_PATH=/home/freemap/X/expires
MAPRENDER_INVALIDATE_MIN_ZOOM=8
MAPRENDER_INDEX_ZOOM=14
MAPRENDER_TILE_CACHE_BASE_PATH=/fm/data4/X-tiles,/fm/data4/X-o-sac,/fm/data4/X-o-hiking,/fm/data4/X-o-ski,/fm/data4/X-o-horse,/fm/data4/X-o-bicycle,/fm/data4/X-o-aerial
MAPRENDER_INDEX=/fm/data4/X-tiles/index,/fm/data4/X-o-sac/index,/fm/data4/X-o-hiking/index,/fm/data4/X-o-ski/index,/fm/data4/X-o-horse/index,/fm/data4/X-o-bicycle/index,/fm/data4/X-o-aerial/index
MAPRENDER_MAX_ZOOM=20
# The renderer serves cache hits itself rather than letting the proxy serve them off
# disk: it is the only thing that can read a tile's attribution out of its xattr
# and put it on the response as X-Attribution.
MAPRENDER_SERVE_CACHED=true
MAPRENDER_CORS=false
MAPRENDER_MAPPING_PATH=mapping.yaml
# Optional overrides for GET /licenses. It answers from each dataset's own
# <HILLSHADING_BASE_PATH>/<key>/attribution.json (see scripts/write-dtm-attribution.nu)
# plus a built-in entry for `osm`, so this is only for a code with no dataset directory.
# MAPRENDER_LICENSES=licenses.json
# Tile variants. Every list below is aligned with MAPRENDER_TILE_URL_PATH: one
# entry each, or a single entry applying to all of them. A variant is a URL
# prefix, a layer group, how that group is read, an output format and its own
# cache directory.
#
# Overlays need an alpha-capable format. `webp` is lossless, which is smaller
# than lossy for sparse line work; `webp-lossy` only pays where the overlay
# covers enough of the tile to be worth it, which in practice is the aerial one.
MAPRENDER_TILE_URL_PATH=/,/o/sac,/o/hiking,/o/ski,/o/horse,/o/bicycle,/o/aerial
MAPRENDER_BASE_MAP=true,true,false,false,false,false,false,true
MAPRENDER_OMIT=;;;;;;;landcover,sea,water-areas,buildings,pier-areas,bridge-areas,solar-plants,trees
MAPRENDER_TILE_FORMAT=jpeg,webp,webp,webp,webp,webp,webp-lossy
MAPRENDER_RENDER=shading,contours,geonames,country-names,country-borders,routes-hiking,routes-horse,routes-bicycle,routes-ski;shading,contours,geonames,country-names,country-borders,routes-hiking-kst;sac-scale;routes-hiking,waymarking;routes-ski;routes-horse;routes-bicycle;
# smoothness needs its column, so /o/smoothness waits for a reimport of the
# roads table — enabling it before that fails the render rather than drawing
# an empty overlay.
MAPRENDER_FONTS_PATH=./fonts
GDAL_CACHEMAX=50MB
