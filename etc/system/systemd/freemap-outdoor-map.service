[Unit]
Description=Freemap Outdoor Map
Requires=postgresql.service
After=postgresql.service

[Service]
Type=simple
Restart=always
RestartSec=1
User=freemap
LimitNOFILE=200000
EnvironmentFile=/etc/freemap-outdoor-map.env
#ExecStart=/usr/bin/heaptrack /home/freemap/.cargo/bin/freemap-outdoor-map
ExecStart=/home/freemap/.cargo/bin/freemap-outdoor-map
WorkingDirectory=/home/freemap
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

