log_format json_access escape=json
        '{'
        '"time":"$time_iso8601",'
        '"request_id":"$request_id",'
        '"remote_addr":"$remote_addr",'
        '"xff":"$http_x_forwarded_for",'
        '"method":"$request_method",'
        '"uri":"$uri",'
        '"args":"$log_args",'
        '"status":$status,'
        '"bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"upstream_time":"$upstream_response_time",'
        '"upstream_status":"$upstream_status",'
        '"upstream_addr":"$upstream_addr",'
        '"referer":"$referrer_norm",'
        '"user_agent":"$http_user_agent",'
        '"tile":"$tile_bucket_scaled"'
        '}';

# A token in the query is a credential; it stays out of the log.
map $args $log_args {
        "~^(?<log_a>(?:.*&)?token=)[^&]*(?<log_b>.*)$"  "${log_a}***${log_b}";
        default                                         $args;
}

# Premium zooms (19+) of the outdoor map, KST and the overlays are served only to
# a premium account's token with the tiles:outdoor scope, asked of the API at
# most once a minute per token. A cache file holds its key, the token, in plain
# text, so the cache lives on tmpfs.
proxy_cache_path /run/nginx-outdoor-tile-auth levels=1:2
        keys_zone=outdoor_tile_auth:10m max_size=100m inactive=10m;

map $request_uri $tile_premium_zoom {
        "~^/(?:o/[a-z][a-z0-9_-]*/|kst/)?(?:19|2[0-9])/"  1;
        default                                           0;
}

# The quarter of premium tiles the web app shows anyone, (x + 2y) % 4 == 0 as in
# its ScaledTileLayer: x ≡ 0 (mod 4) with an even y, or x ≡ 2 with an odd y. A
# number's residue mod 4 is that of its last two digits.
map $request_uri $tile_teaser {
        "~^/(?:o/[a-z][a-z0-9_-]*/|kst/)?\d+/(?:(?:\d*[02468])?[048]|\d*[13579][26])/\d*[02468](?:[@.?]|$)"  1;
        "~^/(?:o/[a-z][a-z0-9_-]*/|kst/)?\d+/(?:(?:\d*[02468])?[26]|\d*[13579][048])/\d*[13579](?:[@.?]|$)"  1;
        default  0;
}

# A browser on a Freemap page, a browser on any other page, or no browser (JOSM,
# Locus). A page can neither drop nor forge Sec-Fetch-Site, nor forge a Freemap
# Referer; www.freemap.eu is cross-site to these tiles, so its Referer tells it.
# A tile opened from the address bar (`none`) counts as an app, so it explains
# itself instead of a bare 403.
map "$http_sec_fetch_site $http_referer" $tile_client {
        default                                                                  foreign;
        "~^(?:none)? "                                                           native;
        "~^(?:same-origin|same-site) "                                           web;
        "~^cross-site https?://(?:[a-z0-9-]+\.)*freemap\.(?:sk|eu)(?::\d+)?/"    web;
}

map $http_authorization $tile_bearer_token {
        "~*^Bearer\s+(?<tile_bt>\S+)$"  $tile_bt;
        default                         "";
}

map $request_uri $tile_query_token {
        "~[?&]token=(?<tile_qt>[^&#]+)"  $tile_qt;
        default                          "";
}

map $tile_bearer_token $tile_token {
        ""       $tile_query_token;
        default  $tile_bearer_token;
}

map $tile_client $premium_zoom_image {
        foreign  outdoor-premium-zoom.png;
        default  outdoor-premium-zoom-token.png;
}

# Get every zoom: the API's offline-map exporter on fm6, and the Freemap Android
# app until it sends a token.
map "$remote_addr $http_user_agent" $tile_trusted_app {
        "~^(?:116\.202\.225\.24|2a01:4f8:241:58aa::2) "    1;
        "~^\S+ flutter_map \(sk\.bigware\.freemap\)"       1;
        default                                            0;
}

# pass, deny, or ask the API. Without a token only the web app's teaser passes.
map "$tile_trusted_app$tile_premium_zoom:$tile_client:$tile_token:$tile_teaser" $tile_gate {
        "~^1"              pass;
        "~^00:"            pass;
        "~^01:foreign:"    deny;
        "~^01:web::1$"     pass;
        "~^01:[a-z]+::"    deny;
        default            check;
}

map $uri $tile_bucket {
        ~^/(?:o/[a-z][a-z0-9_-]*/)?(?<z>\d+)/  /z/$z;
        default                /other;
}

map $uri $tile_scale {
        ~@3x(?:\.|$)            @3x;
        ~@2x(?:\.|$)            @2x;
        default                "";
}

map "$tile_bucket$tile_scale" $tile_bucket_scaled {
        default                "$tile_bucket$tile_scale";
}

map $http_referer $referrer_norm {
        ~^https?://([^.]+\.)*oma\.sk(/.*)?$  https://oma.sk/$1$2;
        default                              $http_referer;
}

map $http_origin $cors_origin {
        default "";
        "https://www.freemap.sk"  $http_origin;
        "https://www.freemap.eu"  $http_origin;
	"https://regobs.no"       $http_origin;
	"~*^https?://local\.freemap\.sk(:\d+)?$"  $http_origin;
	"~*^https?://localhost(:\d+)?$"           $http_origin;
}

# Origins allowed the tiles only, not /export or /legend.
map $http_origin $cors_tile_origin {
        default $cors_origin;
        # Regexes, as an exact key this long overflows map_hash_bucket_size.
        "~^https://(www\.)?mountainski\.cz$"                         $http_origin;
        "~^https://mountainski-web-production\.up\.railway\.app$"    $http_origin;
}

map $url_scale $scale {
        default $url_scale;
        "" 1;
}

# Bots that ignore /robots.txt (which disallows everything).
# ExaSearchBot crawls from ~9500 IPs, so blocking by address is pointless.
map $http_user_agent $ua_is_blocked_bot {
        default                 0;
        "~*ExaSearchBot"        1;
        "~*Baiduspider"         1;
        "~*meta-externalagent"  1;
}

# keep /robots.txt reachable so a blocked bot can still learn it is disallowed
map $uri $uri_is_robots {
        default        0;
        "/robots.txt"  1;
}

map "$ua_is_blocked_bot$uri_is_robots" $blocked_bot {
        default  0;
        "10"     1;
}

server {
        server_name outdoor.tiles.freemap.sk;

        access_log /var/log/nginx/outdoor.tiles.freemap.sk.access.jsonl json_access;

        error_log /var/log/nginx/outdoor.tiles.freemap.sk.error.log;

        if ($blocked_country) {
                return 444;
        }

        if ($blocked_bot) {
                return 444;
        }

        add_header Alt-Svc 'h3=":$server_port"; ma=86400';

        location = /robots.txt {
                default_type text/plain;
                return 200 "User-agent: *\nDisallow: /\n";
        }

        location /goaccess {
                auth_basic "Go home, you are drunk!";
                auth_basic_user_file /etc/nginx/.htpasswd-goaccess;
                alias /var/www/goaccess/;
        }

        location /goaccess/ws {
                auth_basic "Go home, you are drunk!";
                auth_basic_user_file /etc/nginx/.htpasswd-goaccess;

                proxy_pass http://127.0.0.1:7890;

                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";

                proxy_set_header Host $host;
                proxy_read_timeout 1h;
        }

        location /wmts {
                root /var/www/outdoor.wmts;
        }

        location /service {
                proxy_pass http://localhost:4000/service;
        }

        location /export {
                if ($request_method = OPTIONS) {
                        add_header Access-Control-Allow-Origin $cors_origin;
                        add_header Vary Origin always;
                        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS";
                        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin";
                        add_header Access-Control-Max-Age 86400;
                        return 204;
                }

                add_header Access-Control-Allow-Origin $cors_origin always;
                add_header Vary Origin always;
                add_header Alt-Svc 'h3=":$server_port"; ma=86400';
                # Without this the export's attribution header is invisible to the
                # page: a cross-origin reader only sees the CORS-safelisted ones.
                add_header Access-Control-Expose-Headers 'X-Attribution' always;

                proxy_pass http://localhost:4000/export;
        }

        location ~ ^/legend-image/([0-9]+)$ {
                default_type image/png;

                set $scale $arg_scale;

                if ($scale = "") {
                        set $scale 1;
                }

                root /var/www;   # parent of legend-static
                try_files /legend-static/$1--scale=$scale =404;
        }

        #location ~ /(legend-image/.*|legend) {
        location /legend {
                if ($request_method = OPTIONS) {
                        add_header Access-Control-Allow-Origin $cors_origin;
                        add_header Vary Origin always;
                        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS";
                        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin";
                        add_header Access-Control-Max-Age 86400;
                        return 204;
                }

                add_header Access-Control-Allow-Origin $cors_origin always;
                add_header Vary Origin always;
                add_header Alt-Svc 'h3=":$server_port"; ma=86400';

                proxy_pass http://localhost:4000/legend;
                #proxy_pass http://localhost:4000/$1$is_args$args;

                #proxy_cache LEGEND;
                #proxy_ignore_headers Cache-Control;
                #proxy_cache_valid 200 60d;
                #proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
                #proxy_cache_key $scheme$proxy_host$uri$is_args$args;
        }

        location ~ \.index$ {
                return 404;
        }

        # Tiles are proxied rather than served off disk, because only the renderer can
        # read a tile's attribution out of its xattr and put it on the response.
        # It serves cache hits itself (MAPRENDER_SERVE_CACHED=true), renders the misses
        # and handles ?rerender as a query parameter.
        #
        # Cache-Control, Server-Timing, Timing-Allow-Origin, X-Attribution and
        # Access-Control-Expose-Headers all come from upstream. Nothing here hides them,
        # and re-adding one here would send it twice.
        location ~ ^/(?<base>\d+/\d+/\d+)(?:@(?<url_scale>[1234])x)?(?:\.(?:jpe?g|png))?$ {
                # The web app's premium tiles carry Authorization, which preflights.
                if ($request_method = OPTIONS) {
                        add_header Access-Control-Allow-Origin $cors_tile_origin;
                        add_header Vary Origin always;
                        add_header Access-Control-Allow-Headers "Authorization";
                        add_header Access-Control-Max-Age 86400;
                        return 204;
                }

                auth_request /_tile-auth;

                add_header Access-Control-Allow-Origin $cors_tile_origin always;
                add_header Vary Origin always;
                add_header Alt-Svc 'h3=":$server_port"; ma=86400';

                proxy_pass http://localhost:4000/${base}@${scale}x.jpeg$is_args$args;
                error_page 404 /40x.html;
                error_page 401 403 = @premium_zoom;
        }

        location ~ ^/kst/(?<base>\d+/\d+/\d+)(?:@(?<url_scale>[123])x)?(?:\.(?:jpe?g|png))?$ {
                if ($request_method = OPTIONS) {
                        add_header Access-Control-Allow-Origin $cors_tile_origin;
                        add_header Vary Origin always;
                        add_header Access-Control-Allow-Headers "Authorization";
                        add_header Access-Control-Max-Age 86400;
                        return 204;
                }

                auth_request /_tile-auth;

                add_header Access-Control-Allow-Origin $cors_tile_origin always;
                add_header Vary Origin always;
                add_header Alt-Svc 'h3=":$server_port"; ma=86400';

                proxy_pass http://localhost:4000/kst/${base}@${scale}x.jpeg$is_args$args;
                error_page 404 /40x.html;
                error_page 401 403 = @premium_zoom;
        }

        # Overlays: transparent WebP, so no grey 40x tile standing in for a miss.
        # Any variant name, rather than a list that goes stale each time one is
        # added; a path with no variant behind it 404s at the renderer.
        location ~ ^/o/(?<variant>[a-z][a-z0-9_-]*)/(?<base>\d+/\d+/\d+)(?:@(?<url_scale>[123])x)?(?:\.webp)?$ {
                if ($request_method = OPTIONS) {
                        add_header Access-Control-Allow-Origin $cors_tile_origin;
                        add_header Vary Origin always;
                        add_header Access-Control-Allow-Headers "Authorization";
                        add_header Access-Control-Max-Age 86400;
                        return 204;
                }

                auth_request /_tile-auth;

                add_header Access-Control-Allow-Origin $cors_tile_origin always;
                add_header Vary Origin always;
                add_header Alt-Svc 'h3=":$server_port"; ma=86400';

                proxy_pass http://localhost:4000/o/${variant}/${base}@${scale}x.webp$is_args$args;
                error_page 401 403 = @premium_zoom;
        }

        # Decides by $tile_gate; only a token is asked of the API, and its answer
        # cached. A stale answer stands in while the API is unreachable.
        location = /_tile-auth {
                internal;

                if ($tile_gate = pass) {
                        return 204;
                }

                if ($tile_gate = deny) {
                        return 403;
                }

                proxy_pass https://backend.freemap.sk/auth/check?scope=tiles:outdoor&premium=1;
                proxy_pass_request_body off;
                proxy_set_header Content-Length "";
                proxy_set_header Authorization "Bearer $tile_token";
                proxy_set_header Host backend.freemap.sk;
                proxy_ssl_server_name on;

                proxy_cache outdoor_tile_auth;
                proxy_cache_key $tile_token;
                proxy_cache_valid 200 401 403 1m;
                proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
                proxy_ignore_headers Cache-Control Expires Set-Cookie;
        }

        # A refused premium zoom. The web app keeps the 401 or 403 it handles; the
        # rest get an image with 200, as apps like JOSM show no error tile: another
        # site is told to ask us, an app how to add a token.
        location @premium_zoom {
                add_header Access-Control-Allow-Origin $cors_tile_origin always;
                add_header Vary Origin always;
                add_header Cache-Control "no-store" always;

                if ($tile_client = web) {
                        return 403;
                }

                rewrite ^ /premium-zoom.png last;
        }

        location = /premium-zoom.png {
                internal;
                add_header Access-Control-Allow-Origin $cors_tile_origin always;
                add_header Vary Origin always;
                add_header Cache-Control "no-store" always;
                alias /var/www/$premium_zoom_image;
        }

        # Open to any origin, unlike the rest: it is public reference data, nothing
        # here is credentialed, and a code reaches its reader through channels this
        # allowlist does not cover — a saved export, an offline map passed on.
        location = /licenses {
                if ($request_method = OPTIONS) {
                        add_header Access-Control-Allow-Origin "*";
                        add_header Access-Control-Allow-Methods "GET, OPTIONS";
                        # If-None-Match is not CORS-safelisted, so a conditional
                        # fetch preflights and would otherwise fail here.
                        add_header Access-Control-Allow-Headers "If-None-Match";
                        add_header Access-Control-Max-Age 86400;
                        return 204;
                }

                add_header Access-Control-Allow-Origin "*" always;
                add_header Alt-Svc 'h3=":$server_port"; ma=86400';

                proxy_pass http://localhost:4000/licenses;
        }

        http2 on;
        http3 on;

        listen 443 quic reuseport rcvbuf=4m sndbuf=4m;
        listen [::]:443 quic reuseport rcvbuf=4m sndbuf=4m;

        listen 443 ssl;
        listen [::]:443 ssl;
        ssl_certificate /etc/letsencrypt/live/outdoor.tiles.freemap.sk/fullchain.pem; # managed by Certbot
        ssl_certificate_key /etc/letsencrypt/live/outdoor.tiles.freemap.sk/privkey.pem; # managed by Certbot
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}


